{
  "info": {
    "name": "SafeCity API",
    "description": "Colección de pruebas para la API de SafeCity (JSON storage)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/usuarios/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "  pm.collectionVariables.set('token', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/usuarios/login"
      }
    },
    {
      "name": "Get Alerts (page 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/alertas?page=1"
      }
    },
    {
      "name": "Create Alert (no token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Test Alert\",\n  \"descripcion\": \"Testing\",\n  \"tipo\": \"Pothole\",\n  \"latitud\": 10.4,\n  \"longitud\": -75.5,\n  \"categoria_id\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/alertas"
      }
    },
    {
      "name": "Create Alert (with token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Test Alert\",\n  \"descripcion\": \"Testing\",\n  \"tipo\": \"Pothole\",\n  \"latitud\": 10.4,\n  \"longitud\": -75.5,\n  \"categoria_id\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/alertas"
      }
    },
    {
      "name": "Update Alert (admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"resuelta\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/alertas/1"
      }
    },
    {
      "name": "Delete Alert (owner)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/alertas/1"
      }
    },
    {
      "name": "Get Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/alertas/stats"
      }
    },
    {
      "name": "Filter Alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/alertas/filtro?tipo=Pothole&radio=100&lat=10.4&lng=-75.5"
      }
    }
  ]
}